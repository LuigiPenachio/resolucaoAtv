DEFAULT_CAPACITY = 10

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None

    def append(self, value):
        new_node = Node(value)
        new_node.next = self.head
        self.head = new_node

    def search(self, value):
        trav = self.head
        while trav:
            if trav.data == value:
                return True
            trav = trav.next
        return False

    def remove(self, value):
        prev = None
        trav = self.head
        while trav:
            if trav.data == value:
                if prev:
                    prev.next = trav.next
                else:
                    self.head = trav.next
                return True
            prev = trav
            trav = trav.next
        return False

    def __str__(self):
        vals = []
        trav = self.head
        while trav:
            vals.append(str(trav.data))
            trav = trav.next
        return " -> ".join(vals) if vals else " "

class DynamicIntArray:
    def __init__(self, capacity=DEFAULT_CAPACITY):
        if capacity <= 0:
            raise ValueError("Capacidade inicial deve ser maior que 0.")
        self.capacity = capacity
        self.data = [None] * capacity

    def get(self, index):
        if index < 0 or index >= self.capacity:
            raise IndexError("Índice fora dos limites.")
        return self.data[index]

    def set(self, index, value):
        if index < 0 or index >= self.capacity:
            raise IndexError("Índice fora dos limites.")
        self.data[index] = value

    def __str__(self):
        return str([str(bucket) for bucket in self.data])

class HashTable:
    def __init__(self, capacity=DEFAULT_CAPACITY):
        self.buckets = DynamicIntArray(capacity)
        for i in range(capacity):
            self.buckets.set(i, LinkedList())

    def _hash(self, key):
        return key % self.buckets.capacity

    def insert(self, key):
        idx = self._hash(key)
        bucket = self.buckets.get(idx)

        if not bucket.search(key):
            bucket.append(key)

    def search(self, key):
        idx = self._hash(key)
        bucket = self.buckets.get(idx)

        if bucket.search(key):
            return idx
        return None

    def remove(self, key):
        idx = self._hash(key)
        bucket = self.buckets.get(idx)
        return bucket.remove(key)

    def __str__(self):
        lines = []
        for i in range(self.buckets.capacity):
            bucket = self.buckets.get(i)
            lines.append(f"{i}: {bucket}")
        return "\n".join(lines)

if __name__ == "__main__":
    ht = HashTable()

    ht.insert(33)
    ht.insert(14)
    ht.insert(7)
    ht.insert(73)
    ht.insert(23)

    print("Estado da Hash Table após inserções:")
